            </conditions>
            <connector>
                <targetReference>Update_Case</targetReference>
            </connector>
            <label>Still open</label>
        </rules>
    </decisions>
    <description>Re-owns a P0 Case to the on-call dispatcher if it is still New five minutes after routing.</description>
